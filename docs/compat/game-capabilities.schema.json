{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wonderland source preservation capability ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reference_commit",
    "intake",
    "capabilities",
    "qualification"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reference_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "intake": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "requirement"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "unresolved",
              "resolved"
            ]
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_pin",
          "source_paths",
          "source_sha256",
          "upstream_status",
          "product_behavior",
          "rust_paths",
          "provider",
          "dependencies",
          "journey",
          "evidence",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_pin": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "source_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "source_sha256": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "upstream_status": {
            "type": "string",
            "minLength": 1
          },
          "product_behavior": {
            "type": "string",
            "minLength": 1
          },
          "rust_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "journey": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "unassessed",
              "missing",
              "partial",
              "integrated",
              "qualified"
            ]
          },
          "owner_disposition": {
            "type": "object",
            "required": [
              "message_reference",
              "decision"
            ],
            "properties": {
              "message_reference": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "qualification": {
      "type": "string",
      "minLength": 1
    }
  }
}
