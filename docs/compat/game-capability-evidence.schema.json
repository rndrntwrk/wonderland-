{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wonderland capability qualification evidence identity",
  "type": "object",
  "required": ["status", "original_reference", "implementation_commit", "content_release", "capability_ids"],
  "properties": {
    "status": {"const": "passed"},
    "original_reference": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "implementation_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "content_release": {"type": "string", "minLength": 1},
    "capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
