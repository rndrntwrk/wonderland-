{
  "name": "wonderland-native-edge",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "tsc --noEmit",
    "e2e:compaction": "node tests/journal-compaction.mjs && node tests/journal-compaction-crash.mjs",
    "e2e:host-receipt-integration": "node tests/host-receipt-integration.mjs",
    "e2e:host-receipts": "node --test tests/host-receipts.test.mjs",
    "e2e:control-contract": "node tests/control-state-vectors.mjs",
    "e2e": "node tests/durability.mjs && node tests/crash-receipts.mjs",
    "e2e:accounts": "node tests/accounts.mjs && node tests/account-crash.mjs && node tests/account-http.mjs && node --test tests/account-provider-interruption.mjs",
    "e2e:owned": "node tests/owned-export.mjs && node tests/owned-control.mjs && node tests/owned-runtime.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "miniflare@4.20260730.0": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    }
  }
}
